{
    "name": "@arte/ra-apisix-oidc",
    "version": "0.1.0",
    "repository": "git@github.com:artefactGitHub/ra-apisix-oidc.git",
    "author": "Guillaume BILLEY <guillaume@marmelab.com>",
    "license": "MIT",
    "files": [
        "*.md",
        "lib",
        "esm",
        "src"
    ],
    "main": "lib/index",
    "module": "esm/index.js",
    "types": "esm/index.d.ts",
    "sideEffects": false,
    "peerDependencies": {
        "ra-core": "*"
    },
    "dependencies": {
        "jwt-decode": "^4.0.0",
        "keycloak-js": "^26.0.0",
        "ra-core": "^5.1.1"
    },
    "scripts": {
        "build": "yarn run build-cjs && yarn run build-esm",
        "build-cjs": "rimraf ./lib && tsc",
        "build-esm": "rimraf ./esm && tsc --outDir esm --module es2015",
        "watch": "tsc --outDir esm --module es2015 --watch",
        "lint": "eslint --fix ./src",
        "test-unit": "jest"
    },
    "devDependencies": {
        "rimraf": "^6.0.1",
        "typescript": "^5.5.4"
    }
}
